# Senha do banco PostgreSQL
POSTGRES_PASSWORD=moneyflow_secret

# Chave da API (mesma usada no frontend)
API_KEY=troque-por-uma-chave-segura

# URL pública da API (usada pelo navegador, não pelo servidor)
# Em produção, coloque o domínio real: https://api.seudominio.com
API_URL=http://localhost:3001

# URL do frontend (usada pelo CORS da API)
WEB_URL=http://localhost:3000
